<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing leaves this phone: not to cloud backup, and not when the user moves to a new phone.
    android:allowBackup="false" alone stops cloud backup, but on Android 12 and later it no longer
    stops a device-to-device transfer, so every storage area the app uses is excluded here as
    well. (The app keeps nothing in device-protected storage, so those areas are not listed.)
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
